{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "jq -r '.context_window // {} | \"\\((.total_input_tokens // 0) / 1000 | . * 10 | round / 10)k (\\(.used_percentage // 0 | round)%)\"'"
  },
  "modelSettings": {
    "claude-haiku-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark-daltonized"
}
