{
  "agent_buffer_font_size": 14.0,
  "agent_ui_font_size": 16.0,
  "agent": {
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "high"
    },
    "default_profile": "ask",
    "dock": "right",
    "sidebar_side": "right",
  },
  "agent_servers": {
    "cursor": {
      "default_config_options": {
        "mode": "ask",
        "thinking": "true",
        "model": "composer-2.5"
      },
      "favorite_config_option_values": {
        "model": [
          "composer-2.5",
          "claude-fable-5"
        ]
      },
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "biome": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "git-firefly": true,
    "helm": true,
    "html": true,
    "just": true,
    "log": true,
    "material-icon-theme": true,
    "one-dark-pro": true,
    "rainbow-csv": true,
    "ruby": true,
    "sql": true,
    "terraform": true,
    "toml": true,
  },
  "base_keymap": "Cursor",
  "buffer_font_family": "JetBrains Mono NL",
  "buffer_font_size": 18.0,
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Material Icon Theme",
  "outline_panel": {
    "dock": "left",
  },
  "preferred_line_length": 120,
  "project_panel": {
    "dock": "left",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "soft_wrap": "bounded",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_size": 16.0,
    "cursor_shape": "underline",
  },
  "theme": {
    "dark": "One Dark Pro",
    "light": "One Light",
  },
  "ui_font_family": "JetBrains Mono NL",
  "ui_font_size": 16.0,
}
